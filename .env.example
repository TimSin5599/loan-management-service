# Скопируйте этот файл в .env и подставьте свои значения.
# .env не коммитится (см. .gitignore).

SERVER_PORT=8082

# Должен совпадать со значением JWT_SECRET в .env сервиса apigateway —
# иначе не получится проверить подпись токена, выданного gateway.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES

# Общий секрет для внутреннего эндпоинта выдачи кредита (POST /loan-management-service/internal/loans).
# Должен совпадать со значением INTERNAL_API_KEY в .env сервиса credit_operations.
INTERNAL_API_KEY=REPLACE_WITH_AN_INTERNAL_SERVICE_SECRET

# PostgreSQL (см. docker-compose.yml для локального запуска)
DB_URL=jdbc:postgresql://localhost:5432/loan_management
DB_USERNAME=postgres
DB_PASSWORD=postgres
